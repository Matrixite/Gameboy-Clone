// GameBoy FPGA Rev A - Tang Nano 9K package pin constraints
// Tang module pads 40-47 are intentionally unused: they are on the 1.8 V bank.

// On-board 27 MHz oscillator (not a module header pad)
IO_LOC "clk_27m" 52;

IO_LOC "cart_a[0]" 38;
IO_LOC "cart_a[1]" 37;
