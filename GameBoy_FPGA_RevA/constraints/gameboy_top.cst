IO_LOC "cart_a[11]" 34;
IO_LOC "cart_a[12]" 40;
IO_LOC "cart_a[13]" 35;
IO_LOC "cart_a[14]" 41;
IO_LOC "cart_a[15]" 42;

IO_LOC "cart_d[0]" 51;
IO_LOC "cart_d[1]" 53;
IO_LOC "cart_d[2]" 54;
IO_LOC "cart_d[3]" 55;
IO_LOC "cart_d[4]" 56;
IO_LOC "cart_d[5]" 57;
IO_LOC "cart_d[6]" 68;
IO_LOC "cart_d[7]" 69;

